# 本地开发用。生产环境由宿主（豆包工作 / WorkBuddy）注入环境变量，不使用本文件。
# 本连接器不会自动读取 .env；本地调试请用：node --env-file=.env ...

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 可选
WECHAT_DEFAULT_AUTHOR=
WECHAT_DRAFT_STATE_DIR=
WECHAT_DRAFT_ALLOWED_ROOTS=
WECHAT_TITLE_MAX_CHARS=64
WECHAT_AUTHOR_MAX_CHARS=16
WECHAT_DIGEST_MAX_CHARS=120
WECHAT_CONTENT_MAX_CHARS=20000
WECHAT_CONTENT_MAX_BYTES=1048576
