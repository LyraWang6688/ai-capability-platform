# MCP server. Keep loopback binding in production; Nginx is the public edge.
MCP_HOST=127.0.0.1
MCP_PORT=3100

# Existing lark-cli installation and profile on the server.
LARK_CLI_BIN=lark-cli
LARK_PROFILE=your-profile-name
LARK_CLI_TIMEOUT_MS=60000
LARK_CLI_MAX_BUFFER_BYTES=5242880

# Safe default: only localhost Host headers may reach /mcp.
# Do not enable remote mode for ChatGPT until OAuth 2.1 is configured.
MCP_ALLOW_REMOTE=false

# Optional temporary bearer protection for non-ChatGPT MCP clients.
# Required whenever MCP_ALLOW_REMOTE=true in this release.
MCP_BEARER_TOKEN=
